# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Core ---
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/realtydog
ENVIRONMENT=dev

# --- Telegram (create via BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# Comma-separated Telegram user IDs allowed to use the bot (the six of us)
ALLOWED_TELEGRAM_IDS=

# --- Google Maps Platform (drive-time, geocoding, hotels) ---
GOOGLE_MAPS_API_KEY=

# --- LLM for deal-card narratives (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# --- Object storage for photos (S3 / Backblaze B2 / Cloudflare R2 / Supabase) ---
S3_ENDPOINT_URL=
S3_BUCKET=realtydog-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Email digest (SendGrid or SES) ---
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# --- Optional / later ---
# ProPublica Nonprofit Explorer needs no key
SKIPTRACE_API_KEY=

# --- Selection defaults (Layer-1 buy box) ---
BUYBOX_COUNTIES=Dallas,Tarrant
BUYBOX_MIN_ACRES=5
BUYBOX_MIN_SF=15000
BUYBOX_MAX_PURCHASE=4000000
BUYBOX_MAX_ALL_IN=5000000

# --- Notification thresholds (motivation score buckets) ---
MOTIVATION_HOT=60
MOTIVATION_WARM=30
